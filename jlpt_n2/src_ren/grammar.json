[{"n": 1, "p": "～(으)ㄴ 채(로)", "ja": "〜のまま", "ex": "버스 안에서 앉은 채로 잠자버렸다.", "exja": "バスの中で座ったまま寝てしまった。"}, {"n": 2, "p": "～(으)ㄴ/는 걸 보니(까)", "ja": "〜をみると", "ex": "돈을 많이 쓰는 걸 보니 부자인가 봐.", "exja": "お金を沢山使うのをみると、金持ちのようだ。"}, {"n": 3, "p": "～(으)ㄴ/는 김에", "ja": "〜ついでに", "ex": "마트에 가는 김에 친정에도 갔다.", "exja": "スーパーに行くついでに、実家にも行った。"}, {"n": 4, "p": "～(으)ㄴ/는 만큼", "ja": "〜ほど", "ex": "웃는 만큼 인생은 행복해진다.", "exja": "笑うほど人生は幸せになる。"}, {"n": 5, "p": "～(으)ㄴ/는 반면(에)", "ja": "〜の反面", "ex": "택시는 편리한 반면에 지하철보다 비싸다.", "exja": "タクシーは便利な反面、地下鉄より高い。"}, {"n": 6, "p": "～(으)ㄴ/는 법이다", "ja": "〜なものだ", "ex": "계속 노력한다면 개선되는 법이다.", "exja": "ずっと努力したら改善されるものだ。"}, {"n": 7, "p": "～(으)ㄴ/는 탓에", "ja": "〜のせいで", "ex": "운동 안 한 탓에 살이 많이 쪘어요.", "exja": "運動しなかったせいで、とても太りました。"}, {"n": 8, "p": "～(으)ㄴ/는/(으)ㄹ 모양이다", "ja": "〜のようだ", "ex": "비가 오는 모양이다.", "exja": "雨が降るようだ。"}, {"n": 9, "p": "～(으)ㄴ/는/(으)ㄹ 셈이다", "ja": "〜するつもりだ", "ex": "어떻게 할 셈이야?", "exja": "どうするつもり?"}, {"n": 10, "p": "～(으)ㄴ/는/(으)ㄹ 줄 몰랐다", "ja": "〜とは思わなかった", "ex": "공무원 시험에 합격할 줄 몰랐다.", "exja": "公務員試験に合格するとは思わなかった。"}, {"n": 11, "p": "～(으)ㄴ/는/(으)ㄹ 줄 알았다", "ja": "〜と思った", "ex": "아저씨는 연예인이 될 줄 알았는데.", "exja": "おじさんは芸能人になると思っていたのに。"}, {"n": 12, "p": "～(으)ㄴ/는/(으)ㄹ지", "ja": "〜なのか", "ex": "지갑을 어디서 잃어버렸는지 모르겠다.", "exja": "お財布をどこでなくしてしまったのか分からない。"}, {"n": 13, "p": "～(으)ㄴ/는걸(요)", "ja": "〜だよ", "ex": "아직 졸린걸요.", "exja": "まだ眠たいんですよ。"}, {"n": 14, "p": "～(으)ㄴ/는데(요)", "ja": "～ですが", "ex": "이 요리는 생각보다 맛있는데요.", "exja": "この料理は思ったより美味しいのですが。"}, {"n": 15, "p": "～(으)ㄴ/는들", "ja": "〜としても", "ex": "내가 간들 소용없다.", "exja": "私が行ったとしても、役に立たない。"}, {"n": 16, "p": "～(으)ㄴ가 보다", "ja": "〜のようだ", "ex": "그 사람은 선생님인가 봐요.", "exja": "その人は先生のようです。"}, {"n": 17, "p": "～(으)ㄴ가(요)?", "ja": "〜なのか？", "ex": "여자 친구는 예쁜가요?", "exja": "彼女はきれいなんですか？"}, {"n": 18, "p": "～(으)나 마나", "ja": "〜するまでもなく", "ex": "길을 물어보나 마나예요.", "exja": "道を聞くまでもないです。"}, {"n": 19, "p": "～(으)니까(요)", "ja": "〜だから", "ex": "열심히 공부하니까 성적이 우수하다.", "exja": "一生懸命勉強するから、成績が優秀だ。"}, {"n": 20, "p": "～(으)니만큼", "ja": "〜だからこそ", "ex": "노력하니만큼 결과가 기대된다.", "exja": "努力したからこそ結果が期待される。"}, {"n": 21, "p": "～(으)ㄹ 겸  (해서)", "ja": "〜を兼ねて", "ex": "사과할 겸 해서 편지를 썼어요.", "exja": "謝罪を兼ねて手紙を書きました。"}, {"n": 22, "p": "～(으)ㄹ 리가 없다", "ja": "〜するはずがない", "ex": "돈이 부족할 리가 없어요.", "exja": "お金が足りないはずがありません。"}, {"n": 23, "p": "～(으)ㄹ 만하다", "ja": "〜に値する", "ex": "타개책을 시도할 만합니다.", "exja": "打開策を試みるに値します。"}, {"n": 24, "p": "～(으)ㄹ 뻔하다", "ja": "〜しそうだった", "ex": "과음해서 의식을 잃어버릴 뻔했어요.", "exja": "飲みすぎて意識を失いそうだった"}, {"n": 25, "p": "～(으)ㄹ 뿐만 아니라", "ja": "〜だけでなく", "ex": "그 애기는 걸을 뿐만 아니라 잘 달린다.", "exja": "その子は歩くだけでなくよく走る。"}, {"n": 26, "p": "～(으)ㄹ 뿐이다", "ja": "〜だけだ", "ex": "국적이 다를 뿐이지 같은 인간이에요.", "exja": "国籍が違うだけで、同じ人間ですよ。"}, {"n": 27, "p": "～(으)ㄹ 수밖에 (없다)", "ja": "〜するしかない", "ex": "시간이 없으니까 뛰어갈 수밖에 없다.", "exja": "時間がないので走っていくしかない。"}, {"n": 28, "p": "～(으)ㄹ 정도(로)", "ja": "〜するほど", "ex": "놀라울 정도로 크게 외쳤다.", "exja": "驚くほど大きく叫んだ。"}, {"n": 29, "p": "～(으)ㄹ 지경이다", "ja": "〜する寸前だ", "ex": "그녀가 화낼 지경이에요.", "exja": "彼女が怒る寸前です。"}, {"n": 30, "p": "～(으)ㄹ 테니(까)", "ja": "〜するから", "ex": "빨래를 널 테니까 애기를 봐줘.", "exja": "洗濯物を干すから、子供を見てね。"}, {"n": 31, "p": "～(으)ㄹ 텐데", "ja": "〜のはずだが", "ex": "거기에 있을 텐데.", "exja": "そこにあるはずだけど。"}, {"n": 32, "p": "～(으)ㄹ걸 (그랬다)", "ja": "〜すればよかった", "ex": "우산 가져올걸.", "exja": "傘を持ってくればよかった。"}, {"n": 33, "p": "～(으)ㄹ까 말까", "ja": "〜するかどうか", "ex": "건널까 말까 고민했다.", "exja": "渡るかどうか悩んだ。"}, {"n": 34, "p": "～(으)ㄹ수록", "ja": "〜するほど", "ex": "가면 갈수록 힘든 산길.", "exja": "行けば行くほどしんどい山道。"}, {"n": 35, "p": "～(으)ㄹ지(도) 모르다", "ja": "〜か分からない", "ex": "어떻게 편집해야할지 잘 모르겠어요.", "exja": "どう編集したらいいのかよく分かりません。"}, {"n": 36, "p": "～(으)ㄹ지라도", "ja": "〜だとしても", "ex": "아무리 어려울지라도 해낸다.", "exja": "どんなに困難でもやり遂げる。"}, {"n": 37, "p": "～(으)라고 하다", "ja": "〜しなさいと言う", "ex": "아버지가 빨리 손을 씻으라고 했어요.", "exja": "お父さんが早く手を洗いなさいと言いました。"}, {"n": 38, "p": "～(으)려다가", "ja": "〜しようとしていたら", "ex": "외출하려다가 누나가 찾아왔다.", "exja": "外出しようとしていたら姉さんがやってきた。"}, {"n": 39, "p": "～(으)려던 참이다", "ja": "〜しようとしたところだ", "ex": "학교에 가려던 참이에요.", "exja": "学校に行こうとしたところです。"}, {"n": 40, "p": "～(으)려면", "ja": "〜するなら", "ex": "기념사진을 찍으려면 배경은 아름다워야한다.", "exja": "記念写真を撮るなら、背景は美しくなければならない。"}, {"n": 41, "p": "～(으)로 인해(서)", "ja": "〜によって", "ex": "그 이야기는 인터넷으로 인해 확산되었다.", "exja": "その話はインターネットによって拡散された。"}, {"n": 42, "p": "～(으)로서", "ja": "～として", "ex": "선배로서 충고 하나 할게.", "exja": "先輩として忠告を一言いうね。"}, {"n": 43, "p": "～(으)며", "ja": "〜して", "ex": "내 남자친구는 피아노도 잘 치며 노래도 잘해.", "exja": "私の彼氏はピアノも上手で歌もうまい。"}, {"n": 44, "p": "～(으)면 되다", "ja": "〜すればよい", "ex": "웹사이트에서 접수하시면 됩니다.", "exja": "ウェブサイトから手続きをされたらいいでしょう。"}, {"n": 45, "p": "～(으)므로", "ja": "〜ので", "ex": "아침 일찍 일어나야 하므로 이제 잡니다.", "exja": "朝早く起きないといけないのでもう寝ます。"}, {"n": 46, "p": "～(이)나 ～(이)나 할 것 없이", "ja": "〜や〜を問わず", "ex": "아이나 어른이나 할 것 없이 건강은 중요하다.", "exja": "子どもや大人を問わず健康は重要だ。"}, {"n": 47, "p": "～거든", "ja": "〜だよ", "ex": "어려보여도 제가 상사거든요.", "exja": "若く見えたとしても私が上司ですよ。"}, {"n": 48, "p": "～게 하다", "ja": "〜させる", "ex": "동생은 나를 짜증나게 한다.", "exja": "弟は私をイラつかせる。"}, {"n": 49, "p": "～고 나니(까)", "ja": "〜したら", "ex": "푹 쉬고 나니 열이 내려갔어요.", "exja": "よく休んだら熱が下がりました。"}, {"n": 50, "p": "～고 나면", "ja": "〜したら", "ex": "청소하고 나면 기분이 상쾌해진다.", "exja": "掃除したら気分爽快になる。"}, {"n": 51, "p": "～고 나서", "ja": "〜してから", "ex": "이메일 먼저 확인하고 나서 연락드릴게요.", "exja": "e-mailをまず確認してから連絡いたします。"}, {"n": 52, "p": "～고 말고(요)", "ja": "〜に決まっている", "ex": "한국여행은 재미있고 말고요.", "exja": "韓国旅行は楽しいに決まっています。"}, {"n": 53, "p": "～고 말다", "ja": "〜してしまう", "ex": "밤늦게까지 게임하고 말았어요.", "exja": "夜遅くまでゲームをしてしまいました。"}, {"n": 54, "p": "～고 보면", "ja": "〜してみると", "ex": "배우고 보면 쉬운 스페인어.", "exja": "習ってみると簡単なスペイン語。"}, {"n": 55, "p": "～곤 하다", "ja": "〜したりする", "ex": "분식점 앞에서 만나곤 했다.", "exja": "食堂の前で会ったりした。"}, {"n": 56, "p": "～기 쉽다", "ja": "〜しやすい", "ex": "선생님의 수업은 이해하기 쉬워요.", "exja": "先生の授業は理解しやすいです。"}, {"n": 57, "p": "～기 십상이다", "ja": "〜しがちである", "ex": "젊은 운전자는 실수하기 십상이다.", "exja": "若いドライバーはミスをしがちである。"}, {"n": 58, "p": "～기 어렵다", "ja": "〜しにくい", "ex": "작은 신발로는 걷기 어렵다.", "exja": "小さい靴では歩きにくい。"}, {"n": 59, "p": "～기 위해(서)", "ja": "〜のために", "ex": "문제를 해결하기 위해서 다같이 모였다.", "exja": "問題を解決するために皆で集まった。"}, {"n": 60, "p": "～기/게 마련이다", "ja": "〜するものだ", "ex": "준비 안 하면 후회하기 마련이다.", "exja": "準備をしなければ後悔するものだ。"}, {"n": 61, "p": "～기는 하지만", "ja": "〜とはいえ", "ex": "영어는 어렵기는 하지만 재미도 있어요.", "exja": "英語は難しいとはいえ面白みもあります。"}, {"n": 62, "p": "～기는(요)", "ja": "〜だなんて", "ex": "고맙기는요. 별말씀을요.", "exja": "ありがとうだなんて。とんでもないです。"}, {"n": 63, "p": "～기만 하면 (되다)", "ja": "〜さえすれば", "ex": "단어를 외우기만 하면 100점이다.", "exja": "単語を覚えさえすれば100点だ。"}, {"n": 64, "p": "～기에(는)", "ja": "〜するには", "ex": "축구하기에는 날씨가 안 좋아요.", "exja": "サッカーをするには天気が悪いです。"}, {"n": 65, "p": "～길래", "ja": "〜なので", "ex": "남편이 안 오길래 난 바람맞은 줄 알았다.", "exja": "旦那が来ないから、私はドタキャンされたと思った。"}, {"n": 66, "p": "～ㄴ/는 척하다", "ja": "〜のふりをする", "ex": "그 후배는 착한 척한다.", "exja": "その後輩はいい子のふりをする。"}, {"n": 67, "p": "～ㄴ/는다", "ja": "〜だ、する", "ex": "후식에 딸기를 먹는다.", "exja": "デザートにイチゴを食べる。"}, {"n": 68, "p": "～ㄴ/는다거나", "ja": "〜だとか、するとか", "ex": "독서한다거나 영화를 보러 간다.", "exja": "読書するとか、映画を見に行く。"}, {"n": 69, "p": "～ㄴ/는다고 치다", "ja": "〜としたら", "ex": "일본에 간다고 치면 어디로 갈까요?", "exja": "日本に行くとしたらどこに行きましょうか？"}, {"n": 70, "p": "～ㄴ/는다고 하다", "ja": "〜だと言う", "ex": "병원에 안 다닌다고 했어요.", "exja": "病院に通わないと言いました。"}, {"n": 71, "p": "～ㄴ/는다고 해도", "ja": "〜と言っても", "ex": "금연한다고 해도 잘 안 된다.", "exja": "禁煙しようとしても、うまくいかない。"}, {"n": 72, "p": "～ㄴ/는다고(요)", "ja": "〜だそうだ", "ex": "내일은 비가 온다고 해요.", "exja": "明日は雨が降るそうです。"}, {"n": 73, "p": "～ㄴ/는다니", "ja": "〜だなんて", "ex": "5개국어를 한다니 대단합니다.", "exja": "5か国語を話せるなんてすごいです。"}, {"n": 74, "p": "～ㄴ/는다니까", "ja": "〜だってば", "ex": "아무리 이유를 말해도 화를 낸다니까.", "exja": "どんなに理由を言っても怒るんだってば。"}, {"n": 75, "p": "～ㄴ/는다더니", "ja": "～と言ってたけど", "ex": "일찍 돌아온다더니 아직 안 왔다.", "exja": "早く帰ってくると言ったけど、まだ帰ってない。"}, {"n": 76, "p": "～ㄴ/는다더라", "ja": "〜だそうだ", "ex": "내일은 눈이 온다더라.", "exja": "明日は雪が降るそうだ。"}, {"n": 77, "p": "～ㄴ/는다던데", "ja": "〜と言うけど", "ex": "잘 생겼다던데 정말이야?", "exja": "カッコいいというけど本当?"}, {"n": 78, "p": "～ㄴ/는다면", "ja": "〜なら", "ex": "운동선수가 되고 싶다면 전문학원에 등록해야돼.", "exja": "運動選手になりたいなら、専門学校に登録しないと。"}, {"n": 79, "p": "～ㄴ/는다면서(요)?", "ja": "〜なんだって？", "ex": "영어 잘한다면서?", "exja": "英語上手なんだって?"}, {"n": 80, "p": "～나 보다", "ja": "〜するようだ", "ex": "둘이 사귀나 보다.", "exja": "二人は付き合っているようだ。"}, {"n": 81, "p": "～나(요)?", "ja": "〜なの？", "ex": "여기서 타면 되나?", "exja": "ここから乗ったらいいの?"}, {"n": 82, "p": "～냐고 하다", "ja": "〜かと言う", "ex": "엄마가 시험은 언제냐고 했어요.", "exja": "お母さんが試験はいつなのかと言いました。"}, {"n": 83, "p": "～느라고", "ja": "〜したので", "ex": "숙제하느라고 삼촌을 만날 시간이 없었다.", "exja": "宿題をしたので叔父さんに会う時間がなかった。"}, {"n": 84, "p": "～는 (도)중에", "ja": "〜している最中に", "ex": "연기하는 중에 기침해버렸다.", "exja": "演技している最中に咳してしまった。"}, {"n": 85, "p": "～는 길에", "ja": "〜の途中で", "ex": "집에 가는 길에 빵을 사 왔어요.", "exja": "家に行く途中でパンを買ってきました。"}, {"n": 86, "p": "～는 대로", "ja": "～するとおり", "ex": "바라는 대로 이루어진다.", "exja": "願うとおり成される。"}, {"n": 87, "p": "～는 대신(에)", "ja": "〜する代わりに", "ex": "술을 마시는 대신에 녹차를 마시자.", "exja": "お酒を飲む代わりに緑茶を飲もう。"}, {"n": 88, "p": "～는 덕분에", "ja": "〜のおかげで", "ex": "버스가 늦게 온 덕분에 탈 수 있었다.", "exja": "バスが遅く来たおかげで乗ることができた。"}, {"n": 89, "p": "～는 바람에", "ja": "〜せいで", "ex": "공부를 안 한 바람에 성적이 떨어졌어요.", "exja": "勉強をしなかったせいで成績が落ちました。"}, {"n": 90, "p": "～는 사이에", "ja": "〜する間に", "ex": "제가 없는 사이에 택배가 오면 받아주세요.", "exja": "私がいない間に宅配が来たら、受け取ってくださいね。"}, {"n": 91, "p": "～는 셈 치다", "ja": "〜のつもりでいる", "ex": "연습하는 셈 치고 오디션에 간다.", "exja": "練習するつもりでオーディションに行く。"}, {"n": 92, "p": "～는 수(가) 있다", "ja": "〜することがある", "ex": "전문가라고 해도 실패하는 수가 있어요.", "exja": "専門家だといっても、失敗することがあります。"}, {"n": 93, "p": "～는 수밖에 (없다)", "ja": "〜せざるを得ない", "ex": "친척으로부터 돈을 빌리는 수밖에 없다.", "exja": "親戚からお金を借りざるを得ない。"}, {"n": 94, "p": "～는 중이다", "ja": "〜しているところだ", "ex": "지금 직장에 가는 중이에요.", "exja": "今職場に向かっているところです。"}, {"n": 95, "p": "～는 통에", "ja": "〜のせいで", "ex": "아이들이 떠드는 통에 집중할 수 없었어요.", "exja": "子供達が騒ぐせいで集中できませんでした。"}, {"n": 96, "p": "～는 편이다", "ja": "〜する方だ", "ex": "저는 돈을 아끼는 편이에요.", "exja": "私はお金を節約する方です。"}, {"n": 97, "p": "～는 한", "ja": "〜する限り", "ex": "내가 아는 한 그것은 사실이에요.", "exja": "私が知る限りそれは事実です。"}, {"n": 98, "p": "～는 한편", "ja": "〜する一方", "ex": "회사에 다니는 한편 부업도 한다.", "exja": "会社に通う一方で副業もする。"}, {"n": 99, "p": "～는/은커녕", "ja": "〜どころか", "ex": "술은커녕 차도 못 마셨어요.", "exja": "お酒どころかお茶も飲めませんでした。"}, {"n": 100, "p": "～는구나", "ja": "〜なんだね", "ex": "이 애기는 벌써 걷는구나.", "exja": "この子はもう歩くんだね。"}, {"n": 101, "p": "～니/냐?", "ja": "〜なのかい？", "ex": "기분 나쁘니?", "exja": "気を悪くしたかい?"}, {"n": 102, "p": "～다(가) 보니(까)", "ja": "〜していたら", "ex": "작업하다 보니까 새벽이 됐어요.", "exja": "作業していたら朝になってました。"}, {"n": 103, "p": "～다(가) 보면", "ja": "〜してみると", "ex": "심호흡하다 보면 마음이 차분해집니다.", "exja": "深呼吸してみると心が落ち着きます。"}, {"n": 104, "p": "～다가", "ja": "〜していて", "ex": "사용하다가 모르면 물어보세요.", "exja": "使っていて分からなければ聞いてください。"}, {"n": 105, "p": "～다시피", "ja": "〜のとおり", "ex": "보다시피 요즘 직장인은 바빠요.", "exja": "見ての通り最近の社会人は忙しいです。"}, {"n": 106, "p": "～대로", "ja": "〜のとおり", "ex": "교수님의 말씀대로 하자.", "exja": "教授の言葉のとおりにしよう。"}, {"n": 107, "p": "～더군(요)", "ja": "〜なったんだ", "ex": "따님에게 귀여운 이름을 지었더군요.", "exja": "娘さんに可愛いお名前を付けたんですね。"}, {"n": 108, "p": "～더니", "ja": "〜したらなんと", "ex": "강의에 늦었더니 강사님이 야단치셨다.", "exja": "講義に遅れたらなんと講師が叱ってきた。"}, {"n": 109, "p": "～더라", "ja": "〜だよ", "ex": "그 남자는 경찰에 잡혔더라.", "exja": "その男は警察に捕まったんだよ。"}, {"n": 110, "p": "～더라고(요)", "ja": "〜だったよ、～していたよ", "ex": "서울은 도쿄보다 춥더라고요.", "exja": "ソウルは東京よりも寒かったんですよ。"}, {"n": 111, "p": "～더라도", "ja": "〜としても", "ex": "힘겨운 일이 있더라도 참는다.", "exja": "苦しいことがあるとしても、我慢する。"}, {"n": 112, "p": "～던", "ja": "〜した", "ex": "내가 다니던 중학교는 지금은 없어요.", "exja": "私が通った中学校は今はありません。"}, {"n": 113, "p": "～던가(요)?", "ja": "〜だったっけ？", "ex": "오늘 결혼기념일이던가?", "exja": "今日、結婚記念日だったっけ?"}, {"n": 114, "p": "～던데", "ja": "〜していたが", "ex": "길이 막히던데 사고라도 났나?", "exja": "道が混んでいたけど事故でもあったかな？"}, {"n": 115, "p": "～도록", "ja": "〜するように", "ex": "이 은혜를 갚도록 항상 최선을 다하겠습니다.", "exja": "このご恩を返せるように、常に最善を尽くします。"}, {"n": 116, "p": "～든지", "ja": "〜しようが", "ex": "좋든지 싫든지 수능 봐야한다.", "exja": "好きだろうが嫌いだろうが受験をしなければいけない。"}, {"n": 117, "p": "～듯이", "ja": "〜のように", "ex": "미친 듯이 춤췄다.", "exja": "狂ったように踊った。"}, {"n": 118, "p": "(이)라도", "ja": "でも", "ex": "이 문제지라도 풀어볼래요?", "exja": "この問題用紙でも解いてみますか?"}, {"n": 119, "p": "～만 못하다", "ja": "〜に及ばない", "ex": "중고는 신제품만 못해요.", "exja": "中古は新品には及びません。"}, {"n": 120, "p": "～아/어/여 보이다", "ja": "〜そうに見える", "ex": "얼굴표정이 어제보다 밝아 보여요.", "exja": "顔の表情が昨日より明るく見えます。"}, {"n": 121, "p": "～아/어/여서 그런지", "ja": "〜でそうなのか", "ex": "나이가 들어서 그런지 몸이 예전같지 않다.", "exja": "年を取ったせいか、体が昔のようではない。"}, {"n": 122, "p": "～아/어도", "ja": "〜しても", "ex": "설명 들어도 이해 못하겠어요.", "exja": "説明を聞いても、理解できません。"}, {"n": 123, "p": "～아/어라", "ja": "〜せよ、～しろ", "ex": "공을 던져라.", "exja": "ボールを投げろ。"}, {"n": 124, "p": "～아/어야", "ja": "〜してこそ", "ex": "술자리에는 친한 친구가 있어야 재미있다.", "exja": "飲み会には親しい友達がいるからこそ楽しい。"}, {"n": 125, "p": "～아/어야지", "ja": "〜しなきゃ", "ex": "일찍 결혼해야지.", "exja": "早く結婚しなきゃ。"}, {"n": 126, "p": "～아/어지다", "ja": "〜になる", "ex": "인터넷으로 세계는 가까워지고 있어요.", "exja": "インターネットで世界は近くなっています。"}, {"n": 127, "p": "～았/었/였더라면", "ja": "〜だったら", "ex": "은행에서 돈을 찾았더라면 좋았을 텐데.", "exja": "銀行でお金を下ろしていたらよかったのに。"}, {"n": 128, "p": "～았/었/였던 것 같다", "ja": "〜だったらしい", "ex": "걔는 취업했던 것 같다.", "exja": "その子は就職したらしい。"}, {"n": 129, "p": "～았/었으면 하다", "ja": "〜だったら良い", "ex": "점심은 라면이었으면 해.", "exja": "昼食はラーメンだったら良いな。"}, {"n": 130, "p": "(이)야말로", "ja": "こそ", "ex": "지금이야말로 역사적인 순간입니다.", "exja": "今こそ歴史的な瞬間です。"}, {"n": 131, "p": "～에 관해(서)", "ja": "〜について", "ex": "인기 가수에 관해서 새로운 뉴스가 나왔어요.", "exja": "人気歌手について新しいニュースが出ました。"}, {"n": 132, "p": "～에 대해(서)", "ja": "〜に対して", "ex": "부부는 서로에 대해서 배려해야한다.", "exja": "夫婦はお互いに対して配慮しなければならない。"}, {"n": 133, "p": "～에 따라(서)", "ja": "〜に従って", "ex": "예산에 따라 여행일정도 달라져요.", "exja": "予算に従って旅行日程も変わります。"}, {"n": 134, "p": "～에 의해(서)", "ja": "〜によって", "ex": "역경은 희망에 의해서 극복할 수 있다.", "exja": "逆境は希望によって克服できる。"}, {"n": 135, "p": "～에다(가)", "ja": "〜に", "ex": "우유는 냉장고에다가 넣었어요.", "exja": "牛乳は冷蔵庫に入れました。"}, {"n": 136, "p": "～을/를 비롯한", "ja": "〜をはじめとして", "ex": "나를 비롯한 모든 사람들이 찬성한다.", "exja": "私をはじめとして全員が賛成している。"}, {"n": 137, "p": "～을/를 통해(서)", "ja": "〜を通して", "ex": "그 배우는 드라마를 통해서 알게 되었어요.", "exja": "その俳優はドラマを通して知りました。"}, {"n": 138, "p": "～자", "ja": "〜しよう", "ex": "이제 문 닫자.", "exja": "もうドアを閉めよう。"}, {"n": 139, "p": "～자고 하다", "ja": "〜しようと言う", "ex": "동료가 포기하지 말자고 했다.", "exja": "同僚が諦めるのはやめようと言った"}, {"n": 140, "p": "～자마자", "ja": "〜するとすぐ", "ex": "사장님은 좋은 소식을 듣자마자 미소지었다.", "exja": "社長は良い知らせを聞くとすぐに笑顔になった。"}, {"n": 141, "p": "～잖아(요)", "ja": "〜でしょう", "ex": "내가 많이 사줬잖아.", "exja": "私が沢山買ってあげたでしょう?"}, {"n": 142, "p": "마저", "ja": "さえも", "ex": "숙제가 많은 데다가 시간마저 부족하다.", "exja": "宿題が多いうえに時間さえも足りない。"}, {"n": 143, "p": "만큼", "ja": "ほど", "ex": "가족만큼 중요한 것은 없다.", "exja": "家族ほど大切なものはない。"}, {"n": 144, "p": "아무 ～(이)나", "ja": "何の〜でも", "ex": "아무 옷이나 가져오세요.", "exja": "なんの服でもいいから持ってきてください。"}, {"n": 145, "p": "아무 ～도", "ja": "何の〜も", "ex": "아무 걱정도 없어요.", "exja": "何の心配もありません。"}, {"n": 146, "p": "얼마나 ～(으)ㄴ/는지", "ja": "どれほど〜したのか", "ex": "그 당시에는 얼마나 가난했는지 몰라요.", "exja": "その当時はどれほど貧しかったか分かりません。"}, {"n": 147, "p": "조차", "ja": "～さえ", "ex": "기다림조차 설렙니다.", "exja": "待つことでさえワクワクします。"}, {"n": 148, "p": "치고(는)", "ja": "～にしては", "ex": "아이돌치고는 나이가 많다.", "exja": "アイドルにしては、年をとっている。"}]